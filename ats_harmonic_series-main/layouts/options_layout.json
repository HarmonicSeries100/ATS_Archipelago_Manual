              "own_base",
              "own_new_mexico",
              "own_utah",
              "own_colorado"
            ]
          ]
        }
      },
      {
        "type": "group",
        "header": "State Options",
        "content": {
          "type": "itemgrid",
          "item_width": 64,
          "item_height": 64,
          "item_v_alignment": "center",
          "rows": [
            [
              "california_chosen",
              "nevada_chosen",
              "arizona_chosen",
              "new_mexico_chosen",
